// مخطط قاعدة بيانات نظام إدارة موزّعي الغاز.
// القيود الحساسة (عزل الصفوف RLS، منع تعديل سجل التدقيق) مكتوبة بـ SQL داخل ملفات الترحيل
// لأن Prisma لا يعبّر عنها. راجع docs/architecture.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DISTRIBUTOR
}

// حالة حساب المستخدم نفسه (تسجيل الدخول). حالة الموزّع التشغيلية في Distributor.status.
enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum DistributorStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum SuspensionReason {
  MANUAL
  EXPIRED
}

enum AuthMethod {
  PASSWORD
  PIN
}

model User {
  id                 String       @id @default(uuid()) @db.Uuid
  username           String       @unique // يخزن بأحرف صغيرة دائمًا
  passwordHash       String
  role               UserRole
  status             UserStatus   @default(ACTIVE)
  displayName        String
  phone              String?
  // لمديري النظام فقط
  isSuperAdmin       Boolean      @default(false)
  permissions        String[]     @default([])
  // للموزّع: الحساب التابع له
  distributorId      String?      @unique @db.Uuid
  distributor        Distributor? @relation(fields: [distributorId], references: [id])
  failedLoginCount   Int          @default(0)
  lockedUntil        DateTime?
  mustChangePassword Boolean      @default(false)
  passwordChangedAt  DateTime     @default(now())
  lastLoginAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  sessions   Session[]
  devicePins DevicePin[]

  @@map("users")
}

model DistributorCategory {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @unique
  createdAt    DateTime      @default(now())
  distributors Distributor[]

  @@map("distributor_categories")
}

model Distributor {
  id               String               @id @default(uuid()) @db.Uuid
  name             String
  phone            String
  region           String
  status           DistributorStatus    @default(ACTIVE)
  suspensionReason SuspensionReason?
  statusChangedAt  DateTime             @default(now())
  isTrial          Boolean              @default(false)
  // null = بلا مدة محددة
  expiresAt        DateTime?
  isPinned         Boolean              @default(false)
  categoryId       String?              @db.Uuid
  category         DistributorCategory? @relation(fields: [categoryId], references: [id])
  archivedAt       DateTime?
  createdById      String?              @db.Uuid
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  user User?

  cycles       Cycle[]
  statements   Statement[]
  citizens     Citizen[]
  entitlements Entitlement[]
  storedFiles  StoredFile[]
  reviewCases  ReviewCase[]

  @@index([status])
  @@index([expiresAt])
  @@map("distributors")
}

model Session {
  id                 String     @id @default(uuid()) @db.Uuid
  tokenHash          String     @unique
  userId             String     @db.Uuid
  user               User       @relation(fields: [userId], references: [id])
  authMethod         AuthMethod
  // آخر تحقق بكلمة المرور، يُستخدم للعمليات الحساسة
  passwordVerifiedAt DateTime?
  createdAt          DateTime   @default(now())
  lastActivityAt     DateTime   @default(now())
  expiresAt          DateTime
  ip                 String?
  userAgent          String?
  revokedAt          DateTime?
  revokeReason       String?

  @@index([userId])
  @@map("sessions")
}

// PIN مرتبط بجهاز واحد عبر رمز جهاز طويل الأجل مخزّن في ملف تعريف ارتباط محمي.
model DevicePin {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  user            User      @relation(fields: [userId], references: [id])
  deviceTokenHash String    @unique
  pinHash         String
  failedCount     Int       @default(0)
  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime?
  revokedAt       DateTime?

  @@index([userId])
  @@map("device_pins")
}

model LoginAttempt {
  id        BigInt     @id @default(autoincrement())
  username  String
  userId    String?    @db.Uuid
  success   Boolean
  reason    String?
  method    AuthMethod
  ip        String?
  userAgent String?
  createdAt DateTime   @default(now())

  @@index([username, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

// سجل تدقيق للإضافة فقط: trigger في قاعدة البيانات يمنع التعديل والحذف.
model AuditLog {
  id            BigInt   @id @default(autoincrement())
  at            DateTime @default(now())
  actorUserId   String?  @db.Uuid
  actorRole     String?
  distributorId String?  @db.Uuid
  action        String
  entityType    String
  entityId      String?
  before        Json?
  after         Json?
  reason        String?
  ip            String?

  @@index([at])
  @@index([distributorId, at])
  @@index([actorUserId, at])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// صف واحد فقط (id = 1).
model SystemSettings {
  id                 Int      @id @default(1)
  systemName         String   @default("نظام إدارة موزّعي الغاز")
  contactPhone       String?
  contactEmail       String?
  contactAddress     String?
  currencyCode       String   @default("ILS")
  currencySymbol     String   @default("₪")
  sessionIdleMinutes Int      @default(30)
  maxFailedLogins    Int      @default(5)
  lockoutMinutes     Int      @default(15)
  // الشعار (صورة صغيرة) يُحفظ هنا ويُخدم من /api/v1/settings/logo.
  logoData           Bytes?
  logoMime           String?
  // تخصيص أسماء أقسام القائمة وترتيبها: { "/d/counter": { "label": "...", "order": 1, "hidden": false } }
  navOverrides       Json     @default("{}")
  // أنواع الملفات المسموح رفعها (امتدادات) والحد الأقصى لحجم الملف.
  allowedFileTypes   String[] @default(["pdf", "xlsx", "jpg", "jpeg", "png", "webp"])
  maxUploadMb        Int      @default(20)
  // العمل دون اتصال (الشباك فقط): أي العمليات مسموحة، وأقصى عمر لبيانات الجهاز قبل منع العمل دون اتصال وحذفها.
  offlineReceive     Boolean  @default(true)
  offlineDeliver     Boolean  @default(true)
  offlinePayments    Boolean  @default(true)
  offlineMaxAgeHours Int      @default(24)
  updatedAt          DateTime @updatedAt
  updatedById        String?  @db.Uuid

  @@map("system_settings")
}

model ErrorLog {
  id      BigInt   @id @default(autoincrement())
  at      DateTime @default(now())
  level   String
  message String
  stack   String?
  route   String?
  userId  String?  @db.Uuid
  context Json?

  @@index([at])
  @@map("error_logs")
}

// ============================================================
// المرحلة 2: الدورات والكشوف والمواطنون والاستحقاقات
// كل جدول يحمل distributorId وتحميه سياسة RLS (راجع ترحيل phase2).
// ============================================================

enum CycleStatus {
  OPEN
  CLOSED
}

enum CycleEventType {
  OPENED
  CLOSED
  REOPENED
  PRICE_CHANGED
}

model Cycle {
  id            String      @id @default(uuid()) @db.Uuid
  distributorId String      @db.Uuid
  distributor   Distributor @relation(fields: [distributorId], references: [id])
  number        Int // تسلسل الدورة لدى الموزّع
  name          String
  status        CycleStatus @default(OPEN)
  // سعر الجرة في هذه الدورة وعملته وقت الإنشاء. لا يتغير بتغير إعدادات العملة.
  unitPrice     Decimal     @db.Decimal(12, 2)
  currencyCode  String
  openedAt      DateTime    @default(now())
  openedById    String      @db.Uuid
  closedAt      DateTime?
  closedById    String?     @db.Uuid
  createdAt     DateTime    @default(now())

  events       CycleEvent[]
  statements   Statement[]
  entitlements Entitlement[]

  @@unique([distributorId, number])
  @@map("cycles")
}

model CycleEvent {
  id            BigInt         @id @default(autoincrement())
  distributorId String         @db.Uuid
  cycleId       String         @db.Uuid
  cycle         Cycle          @relation(fields: [cycleId], references: [id])
  type          CycleEventType
  reason        String?
  details       Json?
  userId        String         @db.Uuid
  at            DateTime       @default(now())

  @@index([cycleId, at])
  @@map("cycle_events")
}

enum FileKind {
  STATEMENT
}

// بيانات الملف الوصفية. المحتوى في file_blobs (مخزن مؤقت داخل PostgreSQL حتى اعتماد التخزين السحابي).
model StoredFile {
  id            String      @id @default(uuid()) @db.Uuid
  distributorId String      @db.Uuid
  distributor   Distributor @relation(fields: [distributorId], references: [id])
  kind          FileKind
  originalName  String
  mimeType      String
  size          Int
  sha256        String
  storage       String      @default("db")
  storageKey    String?
  createdById   String      @db.Uuid
  createdAt     DateTime    @default(now())

  blob       FileBlob?
  statements Statement[]

  @@index([distributorId, sha256])
  @@map("stored_files")
}

model FileBlob {
  fileId        String     @id @db.Uuid
  file          StoredFile @relation(fields: [fileId], references: [id])
  distributorId String     @db.Uuid
  data          Bytes

  @@map("file_blobs")
}

enum StatementStatus {
  PENDING_REVIEW
  APPROVED
  SUPERSEDED
  DISCARDED
}

enum ParseMethod {
  EXCEL
  PDF_TEXT
  PDF_OCR
}

model Statement {
  id             String          @id @default(uuid()) @db.Uuid
  distributorId  String          @db.Uuid
  distributor    Distributor     @relation(fields: [distributorId], references: [id])
  cycleId        String?         @db.Uuid
  cycle          Cycle?          @relation(fields: [cycleId], references: [id])
  title          String
  // رقم الميزان من رأس كشف الهيئة. الدورة قد تضم عدة كشوف يبدأ تسلسل كل منها من 1،
  // فيصبح رقم المواطن «الميزان-المتسلسل» (295-17) ليبقى فريدًا داخل الدورة.
  scaleNumber    String?
  status         StatementStatus @default(PENDING_REVIEW)
  // الإصدار المعتمد السابق الذي يحل محله هذا الكشف عند التحديث.
  supersedesId   String?         @db.Uuid
  supersedes     Statement?      @relation("StatementVersions", fields: [supersedesId], references: [id])
  supersededBy   Statement[]     @relation("StatementVersions")
  version        Int             @default(1)
  fileId         String          @db.Uuid
  file           StoredFile      @relation(fields: [fileId], references: [id])
  parseMethod    ParseMethod?
  // جدول البيانات الخام المستخرج (صفوف × أعمدة) وربط الأعمدة بالحقول.
  rawTable       Json?
  headerRow      Int?
  columnMapping  Json?
  extraction     Json?
  suggestedCycle String?
  importedById   String          @db.Uuid
  importedAt     DateTime        @default(now())
  approvedById   String?         @db.Uuid
  approvedAt     DateTime?
  discardedById  String?         @db.Uuid
  discardedAt    DateTime?
  discardReason  String?

  rows         StatementRow[]
  entitlements Entitlement[]

  @@index([distributorId, status])
  @@map("statements")
}

enum RowSeverity {
  OK
  WARNING
  ERROR
}

// صف مستخرج من الكشف أثناء المراجعة. لا يُستخدم في أي عملية قبل الاعتماد.
model StatementRow {
  id            String      @id @default(uuid()) @db.Uuid
  distributorId String      @db.Uuid
  statementId   String      @db.Uuid
  statement     Statement   @relation(fields: [statementId], references: [id])
  rowIndex      Int
  nationalId    String?
  fullName      String?
  phone         String?
  citizenNumber String?
  quantity      Int?
  amount        Decimal?    @db.Decimal(12, 2)
  issues        Json        @default("[]")
  severity      RowSeverity @default(OK)
  excluded      Boolean     @default(false)
  editedById    String?     @db.Uuid
  editedAt      DateTime?

  @@unique([statementId, rowIndex])
  @@map("statement_rows")
}

model Citizen {
  id             String      @id @default(uuid()) @db.Uuid
  distributorId  String      @db.Uuid
  distributor    Distributor @relation(fields: [distributorId], references: [id])
  nationalId     String
  fullName       String
  // اسم موحّد للبحث والمطابقة (بلا تشكيل، همزات موحدة).
  nameNormalized String
  phone          String?
  archivedAt     DateTime?
  mergedIntoId   String?     @db.Uuid
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  entitlements Entitlement[]

  @@unique([distributorId, nationalId])
  @@map("citizens")
}

enum EntitlementStatus {
  ACTIVE
  REMOVED
}

enum AmountSource {
  AUTHORITY
  COMPUTED
}

// استحقاق مواطن في دورة. بيانات الهيئة الأصلية محفوظة كما وردت في الكشف المعتمد.
model Entitlement {
  id               String            @id @default(uuid()) @db.Uuid
  distributorId    String            @db.Uuid
  distributor      Distributor       @relation(fields: [distributorId], references: [id])
  cycleId          String            @db.Uuid
  cycle            Cycle             @relation(fields: [cycleId], references: [id])
  citizenId        String            @db.Uuid
  citizen          Citizen           @relation(fields: [citizenId], references: [id])
  statementId      String            @db.Uuid
  statement        Statement         @relation(fields: [statementId], references: [id])
  // رقم المواطن في كشف الهيئة = معرّف الجرة التشغيلي داخل الدورة.
  citizenNumber    String
  nameInStatement  String
  phoneInStatement String?
  quantity         Int
  amountDue        Decimal           @db.Decimal(12, 2)
  amountSource     AmountSource
  unitPrice        Decimal           @db.Decimal(12, 2)
  currencyCode     String
  status           EntitlementStatus @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  changes   EntitlementChange[]
  cylinders Cylinder[]
  payments  Payment[]
  handovers Handover[]

  @@index([distributorId, citizenNumber])
  @@index([citizenId])
  @@map("entitlements")
}

// سجل تغييرات الاستحقاق: تحديث الكشف أو تعديل الموزّع أو الدمج. للإضافة فقط.
model EntitlementChange {
  id            BigInt      @id @default(autoincrement())
  distributorId String      @db.Uuid
  entitlementId String      @db.Uuid
  entitlement   Entitlement @relation(fields: [entitlementId], references: [id])
  source        String
  statementId   String?     @db.Uuid
  before        Json?
  after         Json?
  reason        String?
  userId        String      @db.Uuid
  at            DateTime    @default(now())

  @@index([entitlementId, at])
  @@map("entitlement_changes")
}

model MergeDismissal {
  id            String   @id @default(uuid()) @db.Uuid
  distributorId String   @db.Uuid
  citizenAId    String   @db.Uuid
  citizenBId    String   @db.Uuid
  userId        String   @db.Uuid
  at            DateTime @default(now())

  @@unique([citizenAId, citizenBId])
  @@map("merge_dismissals")
}

enum ReviewCaseType {
  NOT_IN_STATEMENT
  IDENTITY_MISMATCH // تعذر التحقق من الهوية عند استلام أو تسليم
  OFFLINE_CONFLICT // عملية نُفذت دون اتصال ورفضها الخادم عند المزامنة
}

enum ReviewCaseStatus {
  OPEN
  RESOLVED
}

model ReviewCase {
  id            String           @id @default(uuid()) @db.Uuid
  distributorId String           @db.Uuid
  distributor   Distributor      @relation(fields: [distributorId], references: [id])
  type          ReviewCaseType
  status        ReviewCaseStatus @default(OPEN)
  nationalId    String?
  fullName      String?
  phone         String?
  details       String?
  createdById   String           @db.Uuid
  createdAt     DateTime         @default(now())
  resolvedById  String?          @db.Uuid
  resolvedAt    DateTime?
  resolution    String?
  // معرّف العملية المحلية التي رفضها الخادم (حالة واحدة لكل عملية مهما أُعيدت المزامنة).
  sourceOpId    String?

  @@unique([distributorId, sourceOpId])
  @@index([distributorId, status])
  @@map("review_cases")
}

// ============================================================
// المرحلة 3: الجرار والمخزون والشحنات
// ============================================================

enum CylinderStatus {
  EMPTY // استُلمت فارغة من المواطن
  FILLED // معبأة جاهزة
  DELIVERED // سُلّمت للمواطن
  VOID // أُلغيت عملية استلامها
}

// جرة واحدة من استحقاق. رقمها التشغيلي = رقم المواطن (مع لاحقة عند تعدد الجرار)، فريد داخل الدورة.
model Cylinder {
  id            String         @id @default(uuid()) @db.Uuid
  distributorId String         @db.Uuid
  cycleId       String         @db.Uuid
  entitlementId String         @db.Uuid
  entitlement   Entitlement    @relation(fields: [entitlementId], references: [id])
  seq           Int
  label         String
  status        CylinderStatus
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  operations CylinderOperation[]

  @@index([distributorId, status])
  @@index([cycleId, status])
  @@map("cylinders")
}

enum OperationType {
  RECEIVE_EMPTY
  FILL
  DELIVER
}

enum OperationStatus {
  ACTIVE
  CANCELLED
}

enum IdentityMethod {
  MANUAL_ENTRY // أُدخل رقم الهوية من البطاقة يدويًا
  ID_SCAN // قُرئ من صورة البطاقة وأكده المستخدم
}

model CylinderOperation {
  id             String          @id @default(uuid()) @db.Uuid
  distributorId  String          @db.Uuid
  cylinderId     String          @db.Uuid
  cylinder       Cylinder        @relation(fields: [cylinderId], references: [id])
  type           OperationType
  status         OperationStatus @default(ACTIVE)
  // معرّف يولده الجهاز لكل عملية؛ إعادة الإرسال بالمعرّف نفسه لا تنفذ العملية مرتين.
  idempotencyKey String
  shipmentId     String?         @db.Uuid
  shipment       Shipment?       @relation(fields: [shipmentId], references: [id])
  identityMethod IdentityMethod?
  // الوزن بالكيلوغرام (اختياري): وزن الجرة فارغة عند الاستلام، وممتلئة عند التسليم.
  weightKg       Decimal?        @db.Decimal(5, 2)
  // وقت التنفيذ على الجهاز إن نُفذت دون اتصال (at = وقت وصولها للخادم).
  offlineAt      DateTime?
  userId         String          @db.Uuid
  at             DateTime        @default(now())
  cancelledAt    DateTime?
  cancelledById  String?         @db.Uuid
  cancelReason   String?

  @@unique([distributorId, idempotencyKey])
  @@index([cylinderId, at])
  @@map("cylinder_operations")
}

model Station {
  id               String   @id @default(uuid()) @db.Uuid
  distributorId    String   @db.Uuid
  name             String
  phone            String?
  notes            String?
  // سعر شراء الجرة الافتراضي من المحطة؛ يُقترح عند تسجيل الشحنة ويمكن تعديله لها.
  defaultUnitPrice Decimal? @db.Decimal(12, 2)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  shipments Shipment[]
  payments  StationPayment[]

  @@unique([distributorId, name])
  @@map("stations")
}

enum ShipmentStatus {
  ACTIVE
  CANCELLED
}

// استلام شحنة معبأة من محطة. لا يعني دفع قيمتها (الحسابات في المرحلة 4).
model Shipment {
  id             String         @id @default(uuid()) @db.Uuid
  distributorId  String         @db.Uuid
  stationId      String         @db.Uuid
  station        Station        @relation(fields: [stationId], references: [id])
  receivedAt     DateTime
  quantity       Int // إجمالي الجرار المستلمة
  linkedCount    Int // منها جرار مواطنين (تعبئة جرار مستلمة فارغة)
  extraCount     Int // منها كمية غير مرتبطة بمواطنين
  reference      String?
  notes          String?
  // سعر شراء الجرة في هذه الشحنة وعملته وقت الاستلام. قيمة الشحنة = العدد × السعر.
  unitPrice      Decimal        @default(0) @db.Decimal(12, 2)
  currencyCode   String         @default("ILS")
  status         ShipmentStatus @default(ACTIVE)
  idempotencyKey String
  userId         String         @db.Uuid
  createdAt      DateTime       @default(now())
  cancelledAt    DateTime?
  cancelledById  String?        @db.Uuid
  cancelReason   String?

  fills CylinderOperation[]

  @@unique([distributorId, idempotencyKey])
  @@index([distributorId, receivedAt])
  @@map("shipments")
}

enum MovementType {
  RECEIVE_EMPTY // +فارغ
  FILL // -فارغ +معبأ
  DELIVER // -معبأ
  SHIPMENT_EXTRA // +معبأ غير مرتبط بمواطنين
  REVERSAL // عكس حركة سابقة مرة واحدة
}

// سجل حركة المخزون: للإضافة فقط، ويحفظ الرصيد بعد كل حركة.
model InventoryMovement {
  id            BigInt       @id @default(autoincrement())
  distributorId String       @db.Uuid
  type          MovementType
  emptyDelta    Int          @default(0)
  filledDelta   Int          @default(0)
  extraDelta    Int          @default(0)
  emptyAfter    Int
  filledAfter   Int
  extraAfter    Int
  operationId   String?      @db.Uuid
  shipmentId    String?      @db.Uuid
  reversesId    BigInt?      @unique
  note          String?
  userId        String       @db.Uuid
  at            DateTime     @default(now())

  @@index([distributorId, at])
  @@map("inventory_movements")
}

// الرصيد الحالي لكل موزّع. لا يقل عن صفر (قيد في القاعدة).
model InventoryBalance {
  distributorId String   @id @db.Uuid
  empty         Int      @default(0)
  filled        Int      @default(0)
  extra         Int      @default(0)
  updatedAt     DateTime @default(now()) @updatedAt

  @@map("inventory_balances")
}

// ============================================================
// المرحلة 4: المالية
// كل سجل مالي لا يُعدّل ولا يُحذف؛ التصحيح بإلغاء مسبب (ACTIVE → CANCELLED) مرة واحدة.
// ============================================================

enum FinanceStatus {
  ACTIVE
  CANCELLED
}

// تحصيل من مواطن على استحقاق دورة محددة. مستقل عن عمليات الجرار.
model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  distributorId  String        @db.Uuid
  entitlementId  String        @db.Uuid
  entitlement    Entitlement   @relation(fields: [entitlementId], references: [id])
  cycleId        String        @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  currencyCode   String
  paidAt         DateTime
  notes          String?
  status         FinanceStatus @default(ACTIVE)
  idempotencyKey String
  // وقت التسجيل على الجهاز إن سُجل دون اتصال.
  offlineAt      DateTime?
  userId         String        @db.Uuid
  createdAt      DateTime      @default(now())
  cancelledAt    DateTime?
  cancelledById  String?       @db.Uuid
  cancelReason   String?

  @@unique([distributorId, idempotencyKey])
  @@index([entitlementId])
  @@index([distributorId, paidAt])
  @@map("payments")
}

model Expense {
  id             String        @id @default(uuid()) @db.Uuid
  distributorId  String        @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  currencyCode   String
  spentAt        DateTime
  description    String
  status         FinanceStatus @default(ACTIVE)
  idempotencyKey String
  userId         String        @db.Uuid
  createdAt      DateTime      @default(now())
  cancelledAt    DateTime?
  cancelledById  String?       @db.Uuid
  cancelReason   String?

  @@unique([distributorId, idempotencyKey])
  @@index([distributorId, spentAt])
  @@map("expenses")
}

// دفعة من الموزّع لمحطة تعبئة. مستقلة عن استلام الشحنات.
model StationPayment {
  id             String        @id @default(uuid()) @db.Uuid
  distributorId  String        @db.Uuid
  stationId      String        @db.Uuid
  station        Station       @relation(fields: [stationId], references: [id])
  amount         Decimal       @db.Decimal(12, 2)
  currencyCode   String
  paidAt         DateTime
  reference      String?
  notes          String?
  status         FinanceStatus @default(ACTIVE)
  idempotencyKey String
  userId         String        @db.Uuid
  createdAt      DateTime      @default(now())
  cancelledAt    DateTime?
  cancelledById  String?       @db.Uuid
  cancelReason   String?

  @@unique([distributorId, idempotencyKey])
  @@index([stationId, paidAt])
  @@map("station_payments")
}

// ============================================================
// التسليم المبسّط (قرار المالك): «سلّم» واحد لكل استحقاق، دون مراحل فارغة/معبأة.
// تسليم نافذ واحد فقط لكل استحقاق (قيد في قاعدة البيانات)، والتصحيح بالإلغاء مع السبب.
// ============================================================

model Handover {
  id             String          @id @default(uuid()) @db.Uuid
  distributorId  String          @db.Uuid
  entitlementId  String          @db.Uuid
  entitlement    Entitlement     @relation(fields: [entitlementId], references: [id])
  // عدد الجرار المسلّمة = عدد جرار الاستحقاق وقت التسليم.
  quantity       Int
  status         OperationStatus @default(ACTIVE)
  idempotencyKey String
  identityMethod IdentityMethod?
  userId         String          @db.Uuid
  at             DateTime        @default(now())
  // وقت التنفيذ على الجهاز إن نُفذ دون اتصال.
  offlineAt      DateTime?
  cancelledAt    DateTime?
  cancelledById  String?         @db.Uuid
  cancelReason   String?

  @@unique([distributorId, idempotencyKey])
  @@index([entitlementId])
  @@index([distributorId, at])
  @@map("handovers")
}
