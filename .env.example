# ===== قاعدة البيانات =====
# اتصال مالك قاعدة البيانات: يُستخدم للترحيلات وإنشاء دور التطبيق فقط.
# كلمة مرور مالك قاعدة التطوير المحلية في docker-compose (لا تُستخدم في الإنتاج).
LOCAL_DB_PASSWORD="CHANGE_ME"

DATABASE_URL="postgresql://gas_owner:CHANGE_ME@localhost:5433/gas"

# اتصال التطبيق أثناء التشغيل بدور gas_app محدود الصلاحيات (يخضع لعزل الصفوف RLS).
# ينشئه scripts/db-roles.mjs تلقائيًا بكلمة المرور APP_DB_PASSWORD.
APP_DATABASE_URL="postgresql://gas_app:CHANGE_ME_APP@localhost:5433/gas"
APP_DB_PASSWORD="CHANGE_ME_APP"

# ===== الاختبارات =====
TEST_DATABASE_URL="postgresql://gas_owner:CHANGE_ME@localhost:5433/gas_test"
TEST_APP_DATABASE_URL="postgresql://gas_app:CHANGE_ME_APP@localhost:5433/gas_test"
